# ── Performance: browser caching for static assets ──
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # PHP pages are dynamic — do not let browsers cache them
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ── Live domain: always https://iqradaggar.com (no www, no http) ──
# Only applies to iqradaggar.com, so localhost/XAMPP is not affected.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(www\.)?iqradaggar\.com$ [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://iqradaggar.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Disable directory listing ──
Options -Indexes

# ── Retired pages (Our Institute section) → About page ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    # %2 = this folder's URL path ("/" on the live server, "/Iqra_buner/" locally)
    RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
    RewriteRule ^(our-networks|our-projects|accreditation|foundation|clinical-training)\.php$ %2about.php [R=301,L,NC]

    # Retired admission tools → Admission page
    RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
    RewriteRule ^(fee-calculator|scholarships|eligibility-checker)\.php$ %2admission.php [R=301,L,NC]

    # Chairman's / Director's Message pages removed → Leadership page
    RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
    RewriteRule ^(chairman-message|director-message)\.php$ %2leadership.php [R=301,L,NC]
</IfModule>
